{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "trueseal",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-11-07",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "trueseal-db",
      "database_id": "9b524f9f-97f3-4116-9d43-491875a4c58f",
      "preview_database_id": "DB"
    }
  ],
  "env": {
    "production": {
      "vars": {
        "TRUSEAL_PUBLIC_ORIGIN": "https://trueseal-431.pages.dev",
        "TRUSEAL_SIGNING_KID": "trueseal-demo-ed25519-v1"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "trueseal-db",
          "database_id": "9b524f9f-97f3-4116-9d43-491875a4c58f",
          "preview_database_id": "DB"
        }
      ]
    },
    "preview": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "trueseal-preview-db",
          "database_id": "0d767182-5c5b-4644-8c18-9e8bcc1ca3a2",
          "preview_database_id": "DB"
        }
      ]
    }
  }
}
